@inproceedings{caoPromptEditorTaxonomydriven2025,
	address = {New York, NY, USA},
	series = {{SIGMOD}/{PODS} '25},
	title = {Prompt {Editor}: {A} {Taxonomy}-driven {System} for {Guided} {LLM} {Prompt} {Development} in {Enterprise} {Settings}},
